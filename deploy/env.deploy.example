# 복사: cp deploy/env.deploy.example .env.deploy
# 사용: docker compose -f docker-compose.prod.yml --env-file .env.deploy up -d

# GitHub Container Registry 이미지 (저장소 소유자 소문자, Actions 푸시 경로와 동일하게)
# 예: ghcr.io/octocat/dayoff-api:latest
IMAGE_API=ghcr.io/your-github-username/dayoff-api:latest
IMAGE_WEB=ghcr.io/your-github-username/dayoff-web:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-db-password
POSTGRES_DB=dayoff

# 브라우저에서 접속하는 원본 (끝에 / 없음). HTTPS 사이트면 반드시 https:// (http로 빌드하면 브라우저가 API 차단 → 로그인 직후 "Session may have expired")
PUBLIC_ORIGIN=https://your-domain.com
# Contact 페이지 네이버 지도 — 로컬/서버에서 docker compose 로 web 이미지를 빌드할 때만 필요. CI는 GitHub Secret VITE_NAVER_MAP_CLIENT_ID 사용.
# VITE_NAVER_MAP_CLIENT_ID=
# 소셜 콜백 후 ?token= 붙여 보낼 주소 — 접속 호스트와 동일해야 함 (www 유무 포함). 끝 / 없음
FRONTEND_URL=https://your-domain.com

JWT_SECRET=use-long-random-string

HTTP_PORT=80
HTTPS_PORT=443
# 레포 루트 기준 인증서 디렉터리 (Droplet: ~/dayoff/certs 에 cert.pem, key.pem)
CERTS_HOST_PATH=./certs

PORT=4000

# 소셜 (미사용이면 비워두기)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://your-domain.com/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=https://your-domain.com/auth/naver/callback

# --- 토스페이먼츠 (API 컨테이너만 사용. 프론트 VITE_ 변수는 이 프로젝트에서 쓰지 않음) ---
# 개발자센터: https://developers.tosspayments.com/ → API 키 → 결제위젯 연동 키
#   - 클라이언트 키 = TOSS_WIDGET_CLIENT_KEY (위젯용, 브라우저에 노출돼도 되는 키)
#   - 시크릿 키   = TOSS_SECRET_KEY (서버만, 절대 공개 금지)
# 콘솔에서 허용 도메인에 https://your-domain.com (www 쓰면 둘 다) 등록.
# 성공/실패 URL은 서버가 FRONTEND_URL 기준으로 /checkout/success, /checkout/fail 로 넣음.
TOSS_WIDGET_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- Resend 이메일 (가입 환영 / 주문 완료 / 발송 안내) ---
RESEND_API_KEY=
# 형식 예: Day Off <no-reply@your-domain.com>
RESEND_FROM_EMAIL=
# 선택값 (고객 답장 수신 주소)
RESEND_REPLY_TO=

# DATABASE_URL 은 compose 가 postgres 서비스 기준으로 자동 구성함 (위 비밀번호와 일치해야 함)
