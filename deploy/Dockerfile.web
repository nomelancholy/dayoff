# Vite 빌드 → Nginx (정적 + API 프록시는 별도 web 이미지의 nginx.conf에서 upstream 사용)
FROM node:22-bookworm-slim AS web-build
WORKDIR /web
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=
ARG VITE_NAVER_MAP_CLIENT_ID=
ARG VITE_CHECKOUT_ENABLED=false
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_NAVER_MAP_CLIENT_ID=${VITE_NAVER_MAP_CLIENT_ID}
ENV VITE_CHECKOUT_ENABLED=${VITE_CHECKOUT_ENABLED}
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-dayoff-locations.conf /etc/nginx/dayoff-locations.conf
COPY --from=web-build /web/dist /usr/share/nginx/html
